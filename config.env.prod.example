# ===========================================================================
# EarthRISEAgents — PRODUCTION config template
# Inject these via your secret manager / K8s Secret. NEVER commit real values.
# ===========================================================================

# --- Core Django ---
# DEBUG MUST be unset/absent in production. A non-falsy value enables DEBUG and
# DISABLES the transport-security settings below. Leave it out entirely.
# DEBUG=
# REQUIRED: the app refuses to start without this when DEBUG is off.
SECRET_KEY=REPLACE_WITH_A_50CHAR_RANDOM_SECRET
SITE_URL=your.production.host
ALLOWED_HOSTS=your.production.host
# Override only if TLS is terminated in-app rather than at the proxy:
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# --- Database: application connection (Django + agents) ---
# DBHOST also switches PostGIS on; point it at your managed Postgres/PostGIS.
DBHOST=your-postgis-host
DBPORT=5432
DBNAME=dssatserv
DBUSER=postgres
PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# --- Database: postgres CONTAINER init (only if you run the bundled postgres
# image; a managed DB ignores these). Must match the connection vars above. ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=dssatserv
POSTGIS_GDAL_ENABLED_DRIVERS=ENABLE_ALL
POSTGIS_ENABLE_OUTDB_RASTERS=1

# --- Per-agent schemas ---
DATAAGENT_SCHEMA=dataagent
SIMULATION_SCHEMA=simulation
KNOWLEDGE_SCHEMA=knowledge

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- LLM / Ollama ---
OLLAMA_URL=https://your-ollama-host
MODEL_NAME=llama3.1
EMBEDDING_MODEL=nomic-embed-text

# --- Agent client modes (embedded | remote) ---
# DATA_AGENT_MODE=embedded
# KNOWLEDGE_AGENT_MODE=embedded
# DSSAT_AGENT_MODE=embedded

# --- Product / knowledge ---
CUSTOM_AGENT_NAME=DSSATAgent
KNOWLEDGE_DEFAULT_TENANT_ID=dssat
KNOWLEDGE_MAX_DOCS_PER_CATEGORY=4
KNOWLEDGE_MAX_CHUNKS_PER_DOC=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=300
PARENT_CHUNK_SIZE=3000
KNOWLEDGE_DOCUMENTS_DIR=/data/dssat-docs

# --- Copernicus CDS ---
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=REPLACE_WITH_CDS_API_KEY

# --- Email (real SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=REPLACE_WITH_SMTP_USER
EMAIL_HOST_PASSWORD=REPLACE_WITH_SMTP_APP_PASSWORD
DEFAULT_FROM_EMAIL=noreply@your.production.host
