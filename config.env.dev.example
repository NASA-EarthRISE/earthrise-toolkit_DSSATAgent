# ===========================================================================
# EarthRISEAgents — DEVELOPMENT config template
# Copy to `config.env` and adjust. NEVER commit a real config.env.
#   cp config.env.dev.example config.env
# ===========================================================================

# --- Core Django ---
# DEBUG is ON only for a non-falsy value. Absent / empty / 0 / false / f / no /
# off all mean OFF (so a stray DEBUG=false can't enable debug). Prod leaves it unset.
DEBUG=true
# Dev-only throwaway key. In prod, DEBUG is unset and SECRET_KEY is required.
SECRET_KEY=django-insecure-CHANGE-ME-dev-only
SITE_URL=127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal,web,celery

# --- Database: application connection (what Django + the agents connect to) ---
# DBHOST also acts as the switch: if set, the app uses PostGIS; if unset, it
# falls back to a local SQLite file (bare `manage.py` with no DB). Under
# docker-compose the postgres service is reachable at host `postgres`.
DBHOST=postgres
DBPORT=5432
DBNAME=dssatserv
DBUSER=postgres
PASSWORD=CHANGE_ME_local_db_password

# --- Database: postgres CONTAINER init (read by the postgres/postgis image) ---
# These are consumed by the postgres container's entrypoint on FIRST boot of an
# empty data volume — they CREATE the role, password, and database. They must
# match the application connection vars above (POSTGRES_USER=DBUSER,
# POSTGRES_PASSWORD=PASSWORD, POSTGRES_DB=DBNAME) or the app can't log in.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_local_db_password
POSTGRES_DB=dssatserv
# PostGIS raster capabilities the data_agent relies on (GDAL drivers +
# out-of-database rasters). Read by the postgis image, not by the app.
POSTGIS_GDAL_ENABLED_DRIVERS=ENABLE_ALL
POSTGIS_ENABLE_OUTDB_RASTERS=1

# --- Per-agent Postgres schemas (isolation) ---
DATAAGENT_SCHEMA=dataagent
SIMULATION_SCHEMA=simulation
KNOWLEDGE_SCHEMA=knowledge

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- LLM / Ollama ---
OLLAMA_URL=http://host.docker.internal:11434
MODEL_NAME=llama3.1
EMBEDDING_MODEL=nomic-embed-text

# --- Product / knowledge ---
CUSTOM_AGENT_NAME=DSSATAgent
KNOWLEDGE_DEFAULT_TENANT_ID=dssat
KNOWLEDGE_MAX_DOCS_PER_CATEGORY=1
KNOWLEDGE_MAX_CHUNKS_PER_DOC=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=300
PARENT_CHUNK_SIZE=3000
# Mounted copy of the RAG corpus (downloaded out-of-band; see README).
# KNOWLEDGE_DOCUMENTS_DIR=/data/dssat-docs

# --- Copernicus CDS (ERA5/AgERA5/SEAS5) — get a key at cds.climate.copernicus.eu ---
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=CHANGE_ME_cds_api_key

# --- Email (console backend in dev; no real SMTP needed) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@earthrise.local
